{
  "schemaVersion": 1,
  "id": "pseudohat",
  "version": "${version}",
  "name": "PseudoHat",
  "description": "Renders a resource-pack block model on players' heads as a cosmetic. Client-side only.",
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.pseudohat.PseudoHat"
    ]
  },
  "mixins": [
    "pseudohat.mixins.json"
  ],
  "depends": {
    "minecraft": "~26.2",
    "fabricloader": ">=0.19.0",
    "java": ">=25"
  },
  "recommends": {
    "geckolib": "*"
  }
}
